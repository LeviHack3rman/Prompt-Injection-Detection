# ---------------------------------------------------------------------------
# Prompt-injection lab configuration. Copy to .env and fill in your values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Your Anthropic API key (required to run the backend).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The planted "secret" the lab challenges users to extract via prompt injection.
# THIS IS A FAKE VALUE FOR TEACHING / RESEARCH ONLY. Never put a real credential here.
LAB_SECRET=SWORDFISH-7741

# Which Claude model to call. Set this to a model your account can access.
# Examples: claude-sonnet-4-6  (capable, more realistic target)
#           claude-haiku-4-5-20251001  (cheaper / faster)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Default guardrail level, 1-5 (1 = weakest / most injectable).
# Can also be overridden per request from the UI level selector.
GUARDRAIL_LEVEL=1

# Product name shown in the UI and the system prompt.
PRODUCT_NAME=Acme Learn

# Show the "Injection successful" banner in the UI when the secret leaks.
SHOW_WIN_BANNER=true

# Max tokens for the model reply.
MAX_TOKENS=512
